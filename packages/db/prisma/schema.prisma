generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 이슈 하나 = 행 하나. parentId 없으면 좌측 탭, 있으면 하위 화면.
model WireframeIssue {
  id           String           @id @default(cuid())
  parentId     String?
  parent       WireframeIssue?  @relation("IssueTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     WireframeIssue[] @relation("IssueTree")
  projectNo    String
  projectSlug  String
  projectTitle String
  slug         String
  title        String
  issueNo      String
  html         String           @default("")
  sortOrder    Int              @default(0)
  route        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectNo, parentId])
  @@index([projectNo, slug])
  @@map("wireframe_issue")
}
