{
  "name": "wireframe-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "pnpm --parallel --filter @wireframe-studio/api --filter @wireframe-studio/viewer dev",
    "dev:viewer": "pnpm --filter @wireframe-studio/viewer dev",
    "dev:api": "pnpm --filter @wireframe-studio/api dev",
    "build": "pnpm --filter @wireframe-studio/viewer build",
    "preview": "pnpm --filter @wireframe-studio/viewer preview",
    "typecheck": "pnpm -r typecheck",
    "wf": "pnpm --filter @wireframe-studio/cli start",
    "db:push": "pnpm --filter @wireframe-studio/db db:push",
    "db:seed": "pnpm --filter @wireframe-studio/db db:seed",
    "db:setup": "pnpm db:push && pnpm db:seed"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
