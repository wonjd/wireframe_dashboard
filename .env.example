# OpenAI — 대시보드 PRD 확정·보완 에이전트
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Live DB (SELECT 전용) ──────────────────────────────────────────
# 접속 정보는 환경변수로만. config/UI/채팅에 계정·비번을 두지 않는다.
# SSH 터널 + DB 계정. WONJD_DB_CHAT_BOT 과 동일한 키 이름.

USE_SSH_TUNNEL=true

SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
SSH_LOCAL_BIND_HOST=127.0.0.1
SSH_LOCAL_BIND_PORT=13306

DB_HOST=127.0.0.1
DB_PORT=3306
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_QUERY_TIMEOUT_SEC=30
DB_MAX_ROWS=1000
