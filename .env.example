# Prisma datasource. 로컬은 file SQLite.
DATABASE_URL="file:./dev.db"

# --- 와이어프레임 생성 ---
# Cursor API 키 (crsr_...). 서버 전용 (NEXT_PUBLIC_ 금지).
# cursor.com/dashboard → API Keys 에서 발급. 이 키가 없으면 등록/수정/이력은 동작하고
# 생성 Job만 실패로 기록된다.
CURSOR_API_KEY=

# cloud (default): 서버가 Cursor Cloud agent만 착수하고, 상태 폴링이 결과를 수거한다.
# worker: 서버는 PENDING Job만 만든다. 로컬에서 npm run worker 를 켬다.
# GENERATION_MODE=cloud
# CURSOR_BACKEND_URL 은 넣지 말 것 (api2.cursor.sh 로 섞인다).
# CURSOR_API_BASE_URL=https://api.cursor.com

# --- 프로덕션(Vercel)에서만 ---
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# --- 인증 (Phase 0 이후) ---
# AUTH_SECRET=
# AUTH_URL=
# WORKS_CLIENT_ID=
# WORKS_CLIENT_SECRET=
# WORKS_ISSUER=
# WORKS_ALLOWED_DOMAIN_ID=
