// 스펙 §9 데이터 모델.
// provider는 로컬(file SQLite)과 프로덕션(Turso libSQL)에서 동일하다 — §3.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 로그인 사용자. OAuth 연동 전까지는 개발용 스텁 사용자 1명을 seed로 넣는다.
/// 이력이 작성자를 FK로 참조하므로(§8) 인증보다 먼저 존재해야 한다.
model User {
  id          String   @id @default(cuid())
  worksUserId String   @unique
  email       String
  name        String
  createdAt   DateTime @default(now())

  prds      Prd[]
  revisions PrdRevision[]
  jobs      GenerationJob[]
}

model Prd {
  id          String   @id @default(cuid())
  title       String
  /// 현재 PRD 원문 (= 최신 리비전의 sourceText). 의도적 비정규화 — §9 설계 노트
  sourceText  String
  /// sha256(sourceText). 본문 변경 감지용 — §6.2 T2
  contentHash String
  /// "DRAFT" | "GENERATING" | "GENERATED" | "FAILED"
  status      String   @default("DRAFT")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions  PrdRevision[]
  wireframes Wireframe[]
  jobs       GenerationJob[]

  @@index([updatedAt])
}

/// PRD 변경 이력. append-only — 수정/삭제 API를 만들지 않는다 (§8.3).
model PrdRevision {
  id          String   @id @default(cuid())
  prdId       String
  prd         Prd      @relation(fields: [prdId], references: [id], onDelete: Cascade)
  revision    Int
  /// 그 시점의 원문 전체 스냅샷 (§8.1)
  sourceText  String
  contentHash String
  /// "UPLOAD" | "EDIT"
  source      String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  wireframes Wireframe[]

  @@unique([prdId, revision])
  @@index([prdId, createdAt])
}

model Wireframe {
  id            String      @id @default(cuid())
  prdId         String
  prd           Prd         @relation(fields: [prdId], references: [id], onDelete: Cascade)
  version       Int
  /// WireframeDoc 직렬화 (JSON 문자열)
  docJson       String
  /// 어느 리비전에서 생성됐는지 — stale 판정의 기준 (§8.2)
  prdRevisionId String
  prdRevision   PrdRevision @relation(fields: [prdRevisionId], references: [id], onDelete: Cascade)
  model         String
  createdAt     DateTime    @default(now())

  @@unique([prdId, version])
  @@index([prdId, createdAt])
}

model GenerationJob {
  id            String   @id @default(cuid())
  prdId         String
  prd           Prd      @relation(fields: [prdId], references: [id], onDelete: Cascade)
  /// "PENDING" | "RUNNING" | "DONE" | "FAILED"
  status        String   @default("PENDING")
  /// "T1" | "T2" | "MANUAL" — 무엇이 생성을 유발했는지 (§6.2)
  trigger       String
  triggeredById String?
  triggeredBy   User?    @relation(fields: [triggeredById], references: [id])
  wireframeId   String?
  error         String?
  cursorAgentId String?
  cursorRunId   String?
  model         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([prdId, status])
  @@index([prdId, createdAt])
}
